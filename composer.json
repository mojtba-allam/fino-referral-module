{
    "name": "fino/referral-module",
    "description": "A portable Laravel module that receives the finopal/finonet.ir referral signup, gateway and transaction webhooks and provides a host-agnostic referral subsystem.",
    "type": "library",
    "keywords": ["laravel", "module", "referral", "webhook", "finopal", "finonet"],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Modules\\Referral\\": "Modules/Referral/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Modules\\Referral\\ReferralServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
