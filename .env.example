# --- Fino Referral Module ----------------------------------------------
# Copy these into your host .env. Set a strong webhook secret and keep it
# identical to the value finopal is configured to send.

# Required: shared secret guarding all three inbound webhooks.
FINOPAL_WEBHOOK_SECRET=

# Sandbox-first defaults (switch to production when live).
FINOPAL_SANDBOX=true
FINOPAL_API_BASE=https://sandbox.finopal.ir
FINOPAL_REFERRAL_LINK_BASE=https://sandbox.finopal.ir/login

# Referral code generation.
FINOPAL_REFERRAL_CODE_LENGTH=6
FINOPAL_REFERRAL_ROOT_CODE=ROOT01

# Welcome message queued on a new signup-webhook representative.
FINOPAL_WELCOME_SMS_ENABLED=true
# FINOPAL_WELCOME_SMS_TEMPLATE=کاربر گرامی {name}، خوش آمدید. لینک معرفی شما: {link}

# Optional role the host may attach to referral-created users.
# FINOPAL_REPRESENTATIVE_ROLE=Representative

# Per-project inbound webhook toggles. A PMS may disable gateway/transaction;
# sales/payment projects keep all three. Disabled routes return 404.
FINOPAL_WEBHOOK_SIGNUP_ENABLED=true
FINOPAL_WEBHOOK_GATEWAY_ENABLED=true
FINOPAL_WEBHOOK_TRANSACTION_ENABLED=true
